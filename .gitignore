# ── 敏感：密钥与配置 ──────────────────────────────
l2-memory/config.json
**/.env
**/.env.*
!**/.env.example

# ── 运行时 / 环境 ──────────────────────────────
**/node_modules/
**/.venv/
**/__pycache__/
*.pyc
dist/
build/
**/pw-profile/

# ── opencode 工作区运行时（记忆/会话数据，不入库）──
l1-control/opencode/.opencode/memory/
l1-control/opencode/.opencode/node_modules/
l1-control/opencode/.opencode/goals/
l1-control/opencode/.playwright-mcp/

# ── 根点目录：运行时状态（工具各自管理，不入库）──
/.codex/
/.loopx/
/.loopx-runtime/
/.opencode/
/.local/

# ── agents 数据区（运行时数据，不入库）──
/agents/

# ── 语义索引生成物 / 原始数据 ──────────────────
l2-memory/index/
l2-memory/light/
l2-memory/export/
l2-memory/chunks/
l2-memory/logs/
l2-memory/archive/

# ── 工具工厂运行时草案（agentgraph/drafts；*.tool.json 采纳后留痕不入库）──
l2-memory/agentgraph/drafts/

# ── 构建/日志 ────────────────────────────────
*.log
